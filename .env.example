# Server and round settings
NODE_ENV=production
HOST=127.0.0.1
PORT=10100
SESSION_SECRET=replace-with-at-least-32-random-characters
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-dedicated-tunnel-token
ROUND_SECONDS=90
RESULTS_SECONDS=30
MIN_LETTERS=7
MAX_LETTERS=10

# Twitch application credentials. Register this exact OAuth callback URL:
# https://letterchatter.com/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://letterchatter.com/auth/twitch/callback
