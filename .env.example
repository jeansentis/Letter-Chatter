# Server and round settings
PORT=1010
SESSION_SECRET=replace-with-at-least-32-random-characters
ROUND_SECONDS=90
RESULTS_SECONDS=30
MIN_LETTERS=7
MAX_LETTERS=10

# Twitch application credentials. Register this exact OAuth callback URL:
# https://play.example.com/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://play.example.com/auth/twitch/callback
